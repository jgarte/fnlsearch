#!/bin/sh
set -e

SEARCH_HOME=/home/technomancy-search

case "$1" in
    configure)
        # make sure that the technomancy-search user/group exists
        chown technomancy-group ${SEARCH_HOME} 2>/dev/null ||
            adduser --system --disabled-password technomancy-search

        chown -R technomancy-search ${SEARCH_HOME}

        systemctl enable --now technomancy-search.service
        exit 0
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac
